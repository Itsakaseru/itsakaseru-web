---
import { GOOGLE_ANALYTICS_ID } from "astro:env/server";

const analyticsId = import.meta.env.PROD ? GOOGLE_ANALYTICS_ID : undefined;
const tagUrl = analyticsId
	? `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(analyticsId)}`
	: undefined;
const configuration = analyticsId
	? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag("js", new Date());
gtag("config", ${JSON.stringify(analyticsId)});`
	: undefined;
---

{analyticsId && (
		<>
			<script type="text/partytown" src={tagUrl}></script>
			<script type="text/partytown" set:html={configuration}></script>
		</>
	)}
