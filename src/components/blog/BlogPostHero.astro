---
import type { CollectionEntry } from "astro:content";
import { faLayerGroup } from "@fortawesome/free-solid-svg-icons";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { BLOG_MARK_ICONS } from "@/utils/blog.ts";

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const {
	title,
	description,
	category,
	mark,
	tags = [],
	hero,
	accent,
} = post.data;
---

<section
	class:list={[
		"p-3 sm:p-4",
		"rounded-xl bg-snow-100/85",
	]}
	style={`--accent-main: ${accent.main};`}
>
	<div
		class:list={[
			"relative overflow-hidden p-4 sm:p-6 lg:p-8",
			"rounded-lg text-snow-100",
		]}
	>
		{hero?.wide ? (
				<img src={hero.wide.src} alt={hero.wide.alt ?? `${title} hero image`}
					loading="eager"
					fetchpriority="high"
					decoding="async"
					class:list={[
						"absolute inset-0 w-full h-full",
						"object-cover",
					]}
				/>
			) : (
				<div
					class:list={[
						"absolute inset-0",
						"bg-[radial-gradient(circle_at_60%_35%,rgba(255,255,255,0.25),transparent_35%)] opacity-60",
					]}
				/>
			)}
		<div
			class="absolute inset-0"
			style="background: linear-gradient(100deg, color-mix(in srgb, color-mix(in srgb, var(--accent-main) 45%, black) 75%, transparent) 0%, color-mix(in srgb, color-mix(in srgb, var(--accent-main) 45%, black) 40%, transparent) 45%, color-mix(in srgb, color-mix(in srgb, var(--accent-main) 45%, black) 10%, transparent) 100%);"
		/>

		<div class="relative">
			<div class="max-w-4/6 space-y-3">
				<div class="flex flex-wrap items-center gap-3">
					{mark && (
						<span
							class:list={[
								"inline-flex items-center gap-2 px-3 py-1",
								"font-bold text-xs uppercase tracking-widest",
								"rounded-lg bg-snow-100/20 backdrop-blur-sm",
							]}
						>
							<FontAwesomeIcon icon={BLOG_MARK_ICONS[mark]} className="size-3" />
							{mark}
						</span>
					)}
					<span
						class:list={[
							"inline-flex items-center gap-2 px-3 py-1",
							"font-bold text-xs uppercase tracking-widest",
							"rounded-lg bg-snow-100/20 backdrop-blur-sm",
						]}
					>
						<FontAwesomeIcon icon={faLayerGroup} className="size-3" />
						{category}
					</span>

					<!-- Top 3 post tags -->
					{tags.slice(0, 3).map((tag) => (
							<span
						class:list={[
									"px-3 py-1",
									"font-bold text-xs uppercase tracking-widest text-cocoa-400",
									"rounded-lg bg-snow-100/90",
								]}
							>
								#{tag}
							</span>
						))}
				</div>

				<h1
					class="font-manrope font-black text-4xl leading-tight sm:text-5xl xl:text-6xl"
				>
					{title}
				</h1>
				<p
					class="font-light text-sm text-snow-100/85 line-clamp-3 sm:text-base"
				>
					{description}
				</p>
			</div>
		</div>
	</div>
</section>
