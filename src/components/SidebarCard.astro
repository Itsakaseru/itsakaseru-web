---
import {faLink, type IconDefinition} from "@fortawesome/free-solid-svg-icons";
import {FontAwesomeIcon} from "@fortawesome/react-fontawesome";

interface Props {
	title: string
	icon: IconDefinition
}

const { title, icon } = Astro.props
---
<div class="rounded-xl bg-snow-100/85 p-4">
    <div
        class:list={[
            "flex items-center gap-3",
            "text-cocoa-400",
        ]}
    >
        <div
            class:list={[
                "grid size-10 place-items-center",
                "rounded-xl bg-cocoa-100",
            ]}
        >
            <FontAwesomeIcon icon={icon} className="size-4" />
        </div>
        <h2 class="font-manrope text-base font-black">{title}</h2>
    </div>

    <div class="mt-4 grid gap-2">
		<slot />
    </div>
</div>