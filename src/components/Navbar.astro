---
import Search from "@/components/Search.astro";

interface Props {
	variant?: "default" | "home";
}

const { variant = "default" } = Astro.props;
---

<header
	class:list={[
        "relative w-full overflow-hidden sm:p-3",
        "rounded-2xl bg-cocoa-500 p-2 text-snow-100",
    ]}
>
	<div
		class:list={[
            "absolute -left-6 -top-8 sm:-top-10",
            "font-manrope text-7xl font-black text-snow-100/10 sm:text-[9rem]",
            "pointer-events-none",
        ]}
	>
		イサカセル
	</div>

	<div
		class:list={[
        "w-full",
        "relative grid gap-3 lg:items-center",
        variant === "home" ? "lg:grid-cols-[auto_1fr]" : "grid-cols-[1fr_auto] items-center lg:grid-cols-[auto_1fr_auto]",
    ]}
	>
		<a
			class:list={[
                "flex flex-col rounded-xl px-3 py-2 -space-y-1",
                "hover:bg-snow-100/10",
                "transition",
            ]}
			href="/"
		>
			<span class="text-2xl font-bold tracking-tight sm:text-3xl"
				>Itsakaseru</span
			>
			<span class="text-sm font-extralight text-snow-100/75 sm:text-base"
				>Lemuel Lancaster</span
			>
		</a>

		<div
			class:list={[
				variant === "home"
					? "hidden lg:contents"
					: "flex items-center justify-end gap-2 pr-3 lg:contents lg:pr-0",
			]}
		>
			<div
				class:list={[
					variant === "home"
						? "lg:block lg:justify-self-end"
						: "order-2 justify-self-end lg:order-0 lg:w-full lg:justify-self-stretch",
				]}
			>
				<slot />
			</div>

			{variant !== "home" && (
				<div class="order-1 rounded-xl lg:order-0 lg:mr-3 lg:p-1.5 lg:bg-snow-100/10">
					<Search compactOnMobile />
				</div>
			)}
		</div>
	</div>
</header>
