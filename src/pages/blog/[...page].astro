---
import { type CollectionEntry, getCollection } from "astro:content";
import { faBookmark, faNewspaper } from "@fortawesome/free-solid-svg-icons";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import type { GetStaticPaths, Page } from "astro";
import BlogHero from "@/components/blog/BlogHero.astro";
import BlogPostList from "@/components/blog/BlogPostList.astro";
import SidebarCard from "@/components/SidebarCard.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { calculateReadingTime } from "@/utils/blog.ts";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection("blog")).sort(
		(postA, postB) =>
			postB.data.publishedAt.getTime() - postA.data.publishedAt.getTime(),
	);

	return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const articles = (await getCollection("blog")).sort(
	(articleA, articleB) =>
		articleB.data.publishedAt.getTime() - articleA.data.publishedAt.getTime(),
);
const baseDescription =
	"Itsakaseru's blog, where I post tutorials, opinions, updates, information, and other random stuff.";
const description =
	page.currentPage === 1
		? baseDescription
		: `Page ${page.currentPage} of the Itsakaseru blog, where I post tutorials, opinions, updates, information, and other random stuff.`;
const title =
	page.currentPage === 1
		? "Blog | Itsakaseru"
		: `Blog - Page ${page.currentPage} | Itsakaseru`;
const canonical =
	page.currentPage === 1 ? "/blog" : `/blog/${page.currentPage}`;
const categories = [
	...new Set(articles.map((article) => article.data.category)),
];
const totalReadingMinutes = articles.reduce(
	(total, article) =>
		total + Number.parseInt(calculateReadingTime(article.body ?? ""), 10),
	0,
);
---

<DefaultLayout
	title={title}
	description={description}
	canonical={canonical}
	schemaType="CollectionPage"
	prev={page.url.prev}
	next={page.url.next}
>
	<main class="mt-6 space-y-6 sm:mt-10">
		<h1
			class:list={[
				page.currentPage === 1
					? "sr-only"
					: "font-manrope text-3xl font-black text-cocoa-500 sm:text-4xl",
			]}
		>
			Blog{page.currentPage > 1 && ` - Page ${page.currentPage}`}
		</h1>
		{page.currentPage === 1 && <BlogHero posts={articles} />}

		<section class="grid gap-4 lg:grid-cols-[20rem_1fr]">
			<aside class="self-start lg:sticky lg:top-6">
				<SidebarCard title="Blog Information" icon={faNewspaper}>
					<div class="flex flex-col gap-4">
						<div class="grid gap-2">
							<div
								class:list={[
									"p-3",
									"rounded-xl bg-cocoa-100/70 border border-cocoa-200/15",
								]}
							>
								<div class="flex items-center justify-between gap-3">
									<span
										class="font-bold text-xs uppercase tracking-widest text-cocoa-300"
										>Posts</span
									>
									<FontAwesomeIcon
										icon={faBookmark}
										className="size-3 text-cocoa-300"
									/>
								</div>
								<p
									class:list={[
										"mt-2",
										"font-manrope font-black text-3xl leading-none text-cocoa-500",
									]}
								>
									{articles.length}
								</p>
							</div>

							<div class="grid grid-cols-2 gap-2">
								<div
									class:list={[
										"p-3",
										"rounded-xl bg-cocoa-100/70 border border-cocoa-200/15",
									]}
								>
									<p
										class="font-bold text-xs uppercase tracking-widest text-cocoa-300"
									>
										Topics
									</p>
									<p
										class:list={[
											"mt-2",
											"font-manrope font-black text-2xl leading-none text-cocoa-500",
										]}
									>
										{categories.length}
									</p>
								</div>
								<div
									class:list={[
										"p-3",
										"rounded-xl bg-snow-100 border border-cocoa-200/15",
									]}
								>
									<p
										class="font-bold text-xs uppercase tracking-widest text-cocoa-500"
									>
										Minutes
									</p>
									<p
										class:list={[
											"mt-2",
											"font-manrope font-black text-2xl leading-none text-cocoa-500",
										]}
									>
										{totalReadingMinutes}
									</p>
								</div>
							</div>
						</div>

						<div
							class="rounded-xl bg-cocoa-500 p-3 text-snow-100"
							class:list={[
								"p-3",
								"text-snow-100",
								"rounded-xl bg-cocoa-500",
							]}
						>
							<p
								class:list={[
									"font-bold text-xs uppercase tracking-widest text-snow-100/60",
								]}
							>
								Current Focus
							</p>
							<p
								class:list={[
								   "mt-2",
								   "font-light text-sm leading-6 text-snow-100/85",
							   ]}
							>
								Working on rewriting Project Reboot.
							</p>
							<p
								class="mt-3 rounded-lg bg-snow-100/10 px-3 py-2 text-xs leading-5 text-snow-100/75"
								class:list={[
									"mt-3 px-3 py-2",
									"text-xs leading-5 text-snow-100/75",
									"rounded-lg bg-snow-100/10",
								]}
							>
								Last updated from: <br>
								-
								<!--<a-->
								<!--		class="underline"-->
								<!--		href="https://itsakaseru.me/blog/placeholder">-->
								<!--	2026 Q1 Update-->
								<!--</a>-->
							</p>
						</div>
					</div>
				</SidebarCard>
			</aside>

			<BlogPostList page={page} />
		</section>
	</main>
</DefaultLayout>
