---
import { getCollection, render } from "astro:content";
import {
	faArrowUpRightFromSquare,
	faClockRotateLeft,
	faFolderOpen,
	faLink,
} from "@fortawesome/free-solid-svg-icons";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import Image from "astro/components/Image.astro";
import Lemi from "@/assets/lemi.jpg";
import SidebarCard from "@/components/SidebarCard.astro";
import { SOCIAL_LINKS } from "@/components/SocialLink.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import "@/styles/markdown-content.css";

const aboutEntries = await getCollection("about");
const about =
	aboutEntries.find((entry) => entry.id === "profile") ?? aboutEntries[0];

if (!about) {
	throw new Error("Missing about content entry.");
}

const { Content } = await render(about);
const { title, description, accent, documents } = about.data;
const pageTitle = "About Lemuel Lancaster | Itsakaseru";

const roles = ["Programmer", "Oneironatics", "Human"];

const formatDocumentDate = (date: Date) => {
	const datePart = new Intl.DateTimeFormat("en-id", {
		day: "numeric",
		month: "long",
		year: "numeric",
	}).format(date);
	const timePart = new Intl.DateTimeFormat("en-id", {
		hour: "2-digit",
		minute: "2-digit",
		hour12: false,
	}).format(date);

	return `${datePart} - ${timePart}`;
};
---

<DefaultLayout
	title={pageTitle}
	description={description}
	canonical="/about"
	schemaType="ProfilePage"
>
	<main
		class="mt-6 space-y-6 sm:mt-10"
		style={`--accent-main: ${accent.main}; --accent-sub: ${accent.sub ?? "#fff6f4"};`}
	>
		<!-- Hero Section -->
		<section
			class="relative overflow-hidden rounded-xl bg-snow-100 border border-cocoa-200/15 p-3 sm:p-4"
		>
			<div
				class="relative overflow-hidden rounded-lg p-4 text-snow-100 sm:p-8"
				style="background: var(--accent-main)"
			>
				<div
					class="absolute -right-8 -top-8 font-manrope text-[6rem] font-black leading-none text-snow-100/10 sm:-top-10 sm:text-[12rem]"
				>
					レムエル
				</div>

				<div
					class="absolute -bottom-20 left-10 size-48 rounded-full bg-snow-100/20 blur-3xl"
				></div>

				<div class="relative grid gap-8 xl:grid-cols-[1fr_18rem] xl:items-end">
					<div class="max-w-2xl space-y-5">
						<div class="space-y-4">
							<h1
								class="font-manrope text-3xl font-black leading-none sm:text-5xl"
							>
								{title}
							</h1>
							<p
								class="font-manrope text-xl font-black leading-none text-snow-100/90"
							>
								Itsakaseru, Remueru
							</p>
							<p
								class="max-w-2xl text-sm font-light leading-6 text-snow-100/85 sm:text-base"
							>
								{description}
							</p>
						</div>

						<div
							class="max-w-sm rounded-lg bg-snow-100/15 p-3 text-snow-100 backdrop-blur-sm"
						>
							<p
								class="text-xs font-semibold uppercase tracking-[0.14em] text-snow-100/70"
							>
								Roles
							</p>
							<p class="mt-2 font-manrope text-lg font-black leading-none">
								{roles.join(" / ")}
							</p>
						</div>
					</div>

					<div
						class="relative w-fit justify-self-start xl:justify-self-end xl:self-end"
					>
						<div
							class="absolute -left-10 bottom-3 top-3 hidden text-xs font-bold uppercase tracking-[0.28em] text-snow-100/40 xl:block"
							style="writing-mode: vertical-rl;"
						>
							Itsakaseru, Remueru
						</div>

						<div
							class="aspect-square w-44 rounded-2xl bg-snow-100/15 p-3 backdrop-blur-sm sm:w-56"
						>
							<div
								class="grid size-full place-items-center overflow-hidden rounded-xl bg-cocoa-100 p-2"
							>
								<Image
									src={Lemi}
									alt="Itsakaseru portrait"
									width={600}
									height={600}
									loading="eager"
									fetchpriority="high"
									class="aspect-square w-full rounded-lg object-cover"
								/>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Content section -->
		<section class="grid gap-4 lg:grid-cols-[20rem_1fr]">
			<!-- Sidebar content -->
			<aside
				class="order-2 grid gap-4 self-start lg:order-1 lg:sticky lg:top-6"
			>
				<SidebarCard title="Public Documents" icon={faFolderOpen}>
					<div class="flex flex-col gap-2">
						{documents.map((document) => (
                            <a href={document.url} target="_blank" rel="noreferrer" class="group block rounded-lg border border-cocoa-200/20 bg-cocoa-100/70 p-3 transition hover:border-cocoa-200/40 hover:bg-snow-100">
								<span class="flex items-start justify-between gap-3">
									<span>
										<span class="font-manrope text-base font-black text-cocoa-500">{document.title}</span>
									</span>
									<FontAwesomeIcon icon={faArrowUpRightFromSquare} className="mt-1 size-3 shrink-0 text-cocoa-300" />
								</span>
                                <span class="mt-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-cocoa-300">
									<FontAwesomeIcon icon={faClockRotateLeft} className="size-3" />
									{formatDocumentDate(document.updatedAt)}
								</span>
                            </a>
						))}
					</div>
				</SidebarCard>

				<SidebarCard title="Find Me" icon={faLink}>
					<div class="flex flex-col gap-2">
						{SOCIAL_LINKS.length > 0 ? SOCIAL_LINKS.map((link) => (
                            <a href={link.href} target="_blank" rel="noreferrer"  class="flex p-2 justify-between gap-2 rounded-lg border border-cocoa-200/20 bg-snow-100/60 hover:bg-cocoa-200/5 transition">
                                <div class="flex min-w-0 items-center gap-2">
									<FontAwesomeIcon icon={link.icon} className="size-3.5 shrink-0 text-cocoa-300" />
									<p class="truncate text-sm font-semibold text-cocoa-500">{link.name}</p>
								</div>
                                <FontAwesomeIcon icon={faArrowUpRightFromSquare} className="size-3 my-auto -translate-y-px" />
                            </a>
					)) : (
                            <p class="rounded-lg bg-snow-100/60 px-3 py-2 text-sm text-cocoa-300">No external links listed yet.</p>
						)}
					</div>
				</SidebarCard>
			</aside>

			<!-- Main content -->
			<section class="order-1 min-w-0 space-y-4 lg:order-2">
				<article
					class="markdown-content min-w-0 rounded-xl bg-snow-100 border border-cocoa-200/15 py-4 px-6 sm:py-8 sm:px-12"
				>
					<Content />
				</article>
			</section>
		</section>
	</main>
</DefaultLayout>
