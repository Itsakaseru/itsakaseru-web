---
import Background from "@/components/Background.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import NavigationLink from "@/components/NavigationLink.tsx";
import BaseLayout from "./BaseLayout.astro";

const currentPath = Astro.url.pathname;
---

<BaseLayout {...Astro.props}>
	<body class="min-h-screen relative">
		<Background />
		<div
			class="flex min-h-dvh flex-col rounded-2xl p-4 sm:px-6 sm:pt-6 sm:pb-4 lg:px-10 lg:pt-10 lg:pb-4"
		>
			<Navbar>
				<NavigationLink client:load currentPath={currentPath} />
			</Navbar>
			<div class="flex-1"><slot /></div>
			<Footer />
		</div>
	</body>
</BaseLayout>
